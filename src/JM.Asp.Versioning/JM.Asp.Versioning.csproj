<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<IsPackable>true</IsPackable>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<TargetFrameworks>net6.0;net7.0;net8.0;net9.0;net10.0</TargetFrameworks>
		<!-- net6.0 and net7.0 are out of support, but they are still valid targets for this package. -->
		<CheckEolTargetFramework>false</CheckEolTargetFramework>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<Version>2.0.0</Version>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageProjectUrl>https://github.com/joaomissio/JM.Asp.Versioning</PackageProjectUrl>
		<RepositoryUrl>https://github.com/joaomissio/JM.Asp.Versioning.git</RepositoryUrl>
		<PackageTags>Asp;AspNet;AspNetCore;WebAPI;Versioning;ApiVersioning</PackageTags>
		<Authors>João Orlando Missio</Authors>
		<Description>A service API versioning library for Microsoft ASP.NET Web API. Controls the lifecycle of endpoints on top of Asp.Versioning.</Description>
		<PackageReleaseNotes>Added net9.0 and net10.0 targets. [ApiVersionRemove] now creates an API version. Fixed the (major, minor) attribute constructors. See the README for the 1.x to 2.0 migration notes.</PackageReleaseNotes>
		<AssemblyName>JM.Asp.Versioning</AssemblyName>
		<PackageIcon>dotnet.png</PackageIcon>
		<RepositoryType>git</RepositoryType>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	</PropertyGroup>

	<PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
		<ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
	</PropertyGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<PackageReference Include="Asp.Versioning.Mvc" Version="10.2.1" />
		<PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" Version="10.2.1" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net9.0' Or '$(TargetFramework)' == 'net8.0'">
		<PackageReference Include="Asp.Versioning.Mvc" Version="8.1.1" />
		<PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" Version="8.1.1" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net7.0'">
		<PackageReference Include="Asp.Versioning.Mvc" Version="7.1.1" />
		<PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" Version="7.1.0" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net6.0'">
		<PackageReference Include="Asp.Versioning.Mvc" Version="6.4.1" />
		<PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" Version="6.4.0" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="JM.Asp.Versioning.Tests" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\licenses\LICENSE.txt" Pack="true" PackagePath="LICENSE.txt" />
		<None Include="..\..\README.md" Pack="true" PackagePath="README.md" />
		<None Include="..\..\docs\dotnet.png" Pack="true" PackagePath="" />
	</ItemGroup>
</Project>
