<Project Sdk="Microsoft.NET.Sdk">

  <!-- Controllers used by the integration tests. They live in their own assembly
       so that version auto-detection only sees these attributes. -->
  <PropertyGroup>
    <TargetFrameworks>net6.0;net7.0;net8.0;net9.0;net10.0</TargetFrameworks>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\JM.Asp.Versioning\JM.Asp.Versioning.csproj" />
  </ItemGroup>

</Project>
